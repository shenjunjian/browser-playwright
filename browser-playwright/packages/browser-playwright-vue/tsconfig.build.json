{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.build.tsbuildinfo",
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "declarationDir": "dist",
    "allowImportingTsExtensions": false,
    "types": []
  },
  "include": ["src/index.ts", "src/env.d.ts", "src/components/**/*.vue"]
}
